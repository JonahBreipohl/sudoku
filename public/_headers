# Cloudflare static hosting headers. Read by Cloudflare, never served or precached.

# The service worker and the shell must be revalidated on every load, so a deploy reaches
# players on their next visit instead of whenever a stale cache expires.
/sw.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Vite fingerprints everything under assets/, so it never changes in place.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
